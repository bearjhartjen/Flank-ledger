#!/bin/sh
# pre-commit — sync the Desktop ledger into the repo, rebuild the site, and
# stage the result so a single commit carries both the updated ledger and the
# regenerated site. Safe to run from any directory and quiet when there is
# nothing to do.
#
# Notes on the shell:
#   * `set -e` aborts on any unhandled failure. Calls whose non-zero exit is
#     meaningful here (`cmp`, the build) are guarded with `if`/`||` so they
#     never abort the script.
set -e

ROOT=$(git rev-parse --show-toplevel) || {
  printf 'pre-commit: not inside a git repository.\n' >&2
  exit 1
}

SRC="$HOME/Desktop/The Flank.md"
DST="$ROOT/data/The Flank.md"
BUILD="$ROOT/scripts/build.py"
SITE="$ROOT/site"

changed=0

# 1. Sync the ledger, but only when there is something to sync. Comparing
#    contents covers both "newer" and "different"; an identical source is
#    left alone so a rebuild is not triggered for no reason.
if [ -f "$SRC" ]; then
  if [ ! -f "$DST" ] || ! cmp -s "$SRC" "$DST"; then
    mkdir -p "$(dirname "$DST")"
    cp "$SRC" "$DST"
    changed=1
    printf 'pre-commit: synced "%s" -> data/The Flank.md\n' "$SRC"
  fi
else
  # A missing Desktop file must not block committing the rest of the work.
  printf 'pre-commit: "%s" not found; skipping ledger sync.\n' "$SRC"
fi

# 2. Rebuild the site. A failed build aborts the commit so a broken site is
#    never published. (A missing build.py is a setup gap, not a build error,
#    so it is reported and skipped rather than failing every commit.)
if [ -f "$BUILD" ]; then
  if ! out=$(python3 "$BUILD" 2>&1); then
    printf '%s\n' "$out" >&2
    printf 'pre-commit: site build FAILED. Commit aborted.\n' >&2
    printf 'pre-commit: bypass with: git commit --no-verify\n' >&2
    exit 1
  fi
  if [ "$changed" -eq 1 ]; then
    printf 'pre-commit: rebuilt site/ (ledger changed).\n'
  fi
else
  printf 'pre-commit: scripts/build.py not found; skipping site build.\n'
fi

# 3. Stage the updated ledger and the regenerated site. The ledger filename
#    contains a space, so each path is added separately and quoted.
if [ -f "$DST" ]; then
  git add -- "data/The Flank.md"
fi
if [ -d "$SITE" ]; then
  git add -- site
fi

exit 0
